{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CozAlyze Tropical Reading (generator output)",
  "type": "object",
  "required": ["system", "title", "subtitle", "fixture", "sections"],
  "properties": {
    "system":   { "const": "tropical" },
    "title":    { "const": "Your Tropical Reading" },
    "subtitle": { "const": "Your Outer Expression" },
    "fixture":  { "const": false },
    "userId":   { "type": "string" },
    "chartId":  { "type": "string" },
    "generatedAt": { "type": "string" },
    "sections": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "body", "sourceFactors"],
        "properties": {
          "id":     { "enum": ["at-your-core","love-desire-creativity","work-money-expression","wisdom-purpose-legacy","challenges-resilience","essential-takeaway"] },
          "number": { "type": "integer", "minimum": 1, "maximum": 6 },
          "title":  { "type": "string" },
          "body":   { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 40 } },
          "sourceFactors": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
